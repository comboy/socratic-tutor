#!/usr/bin/env node
// Learning workspace CLI. No dependencies. Run `bin/learn help`.
'use strict';
const fs = require('fs');
const path = require('path');
const { spawn } = require('child_process');
const S = require('../app/store');
const T = require('../app/session');
const { api, serverUp } = require('../app/client');

const argv = process.argv.slice(2);
let cmd = 'start';   // `bin/learn`, `bin/learn <topic>`, `bin/learn -c` all start

function flags(args, spec) {
  // spec: { name: 'string'|'bool' }
  const out = { _: [] };
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--') { out['--'] = args.slice(i + 1); break; }
    const m = a.match(/^--?([a-z-]+)(?:=(.*))?$/);
    if (m && spec[m[1]]) {
      if (spec[m[1]] === 'bool') out[m[1]] = true;
      else out[m[1]] = m[2] != null ? m[2] : args[++i];
    } else out._.push(a);
  }
  return out;
}
function die(msg) { console.error('learn: ' + msg); process.exit(1); }
// For commands whose positionals are ids or patterns, not free text: an unknown -x / --xyz is a
// mistake (a typo, or a grep flag), never something to search for. After `--` anything goes.
function noStrayFlags(f, spec, usage) {
  const bad = f._.filter(a => /^--?[a-z]/i.test(a));
  if (bad.length) die(`unknown option ${bad.join(' ')} (options: ${Object.keys(spec).map(k => (k.length === 1 ? '-' : '--') + k).join(' ')})${usage ? '\nusage: ' + usage : ''}`);
  return f;
}
function readStdin() { try { return fs.readFileSync(0, 'utf8'); } catch { return ''; } }
const list = s => (s ? String(s).split(',').map(x => x.trim()).filter(Boolean) : []);

function defaultTopic() {
  const sess = T.readSession();
  if (process.env.LEARN_SESSION && sess?.id === process.env.LEARN_SESSION && sess.topic && S.listTopics().includes(sess.topic)) return sess.topic;
  const last = S.lastEntry(e => e.role === 'user' && !e.imported);
  if (last && S.listTopics().includes(last.topic)) return last.topic;
  const t = S.listTopics();
  if (t.length === 1) return t[0];
  // most recently modified journal
  let best = null, bt = 0;
  for (const slug of t) for (const f of S.journalFiles(slug)) {
    const m = fs.statSync(path.join(S.journalDir(slug), f)).mtimeMs;
    if (m > bt) { bt = m; best = slug; }
  }
  return best || t[0] || null;
}
// Topic for a command: --topic, else a leading positional that names a topic, else the default.
// strict: the first positional is a topic or a skill id, so a word that isn't a topic is a mistake.
function topicOf(f, strict = false) {
  let t = f.topic;
  if (!t && f._.length && S.listTopics().includes(f._[0])) t = f._.shift();
  else if (!t && strict && /^[a-z][a-z0-9-]*$/.test(f._[0] || '')) die(`unknown topic ${f._[0]} (topics: ${S.listTopics().join(', ') || 'none'})`);
  t = t || defaultTopic();
  if (!t) die('no topic yet; pass --topic');
  if (!S.listTopics().includes(t)) die(`unknown topic ${t}`);
  return t;
}
const ago = ms => ms < 90e3 ? 'just now' : ms < 90 * 60e3 ? `${Math.round(ms / 60e3)} min ago` : ms < 36 * 3600e3 ? `${Math.round(ms / 3600e3)} h ago` : `${Math.round(ms / 86400e3)} days ago`;
const firstLine = (text, n = 110) => {
  const h = String(text || '').match(/^#{1,3} +(.+)$/m);
  const t = (h ? h[1] : String(text || '')).replace(/```[\s\S]*?```/g, '[code]').replace(/\$\$[\s\S]*?\$\$/g, '[formula]').replace(/[*_`#>]/g, '').replace(/\s+/g, ' ').trim();
  return t.length > n ? t.slice(0, n - 1) + '…' : t;
};

// ---------------------------------------------------------------- commands
const commands = {};

commands.help = () => {
  console.log(`bin/learn                                web UI + idle tutor + browser; the only command the learner needs
                                         (already running? it just opens the browser)
bin/learn serve                          web server only (http://localhost:${S.PORT})
bin/learn demo [--real] [--port n]       try the UI on a throwaway copy of the demo data, with a fake tutor
bin/learn test [--headed] [--keep]       acceptance tests (fixture data, fake tutor, headless Chrome)
bin/learn share check [--history] · share export <dir>   personal traces in the code repo · a fresh repo to publish
bin/learn away [jobs…] | --list | --snapshot   learner is away: a planner picks the jobs (or run these: builder, reviewer, wiki, janitor, task)

Tutor commands (docs/protocol.md). [t] = optional topic, defaults to the current one:
bin/learn resume [t]                     everything needed to pick up a topic, in one compact print
bin/learn wait                           block until the learner sends something
bin/learn post [--topic t] [--skill ids] [--grade v] [--grade-skill id] [--note s] [--expect rubric] [--force]  < markdown
bin/learn post --meta [--topic t]  < markdown   a reply about the app (to a META message), kept out of the lesson
bin/learn meta [t] <id>… [--off]         tag past entries as app talk (append-only; --off takes the tag back)
bin/learn level [t] <skill> <0-5> "reason"
bin/learn focus [t] <skill>              set the current focus
bin/learn note <review|hole|parked|misconception> [--skill id|@foundation] [--ref msg] [--due 3d] "text"
bin/learn note done <id> ["outcome"]  ·  note list [--all]
bin/learn summary [t] <skill> "- bullet with (msg:…) links"   append to a skill's summary
bin/learn term add [t] "name" --short "…" [--skill id] [--full …] [--aliases a,b] [--parts …] [--see …] [--refs …] [--body "…" | --body - < file]
bin/learn term show [t] <name>  ·  terms [t]  ·  terms-missing [t] [--last n | --all]   bold phrases not in the glossary
bin/learn term pages [t]                 terms with their own page (terms/<name>.md), and the most-mentioned ones without
bin/learn tree [t]                       print the skill tree as an outline · tree [t] --set < outline  (replace it)
bin/learn legend [t] [set <key> <#color> "label" [--term name] | rm <key>]   colours for recurring things in diagrams
bin/learn log [t] "what happened"        append to today's entry in log.md
bin/learn feedback "remark"              a note for the builder about the app or the process (not the lesson)
bin/learn pending [t] · recent [n] [--topic t] · msgs [t] --skill id · status · grep [-i|--case] <regex> [--topic t]
bin/learn show [--topic t] <id> · show <topic>/<id>   ids repeat across topics (2026-11-21.4 in two topics)
                                         (msgs and grep leave out app talk; --all includes it)
bin/learn image [t] <Commons file/URL | file --author a --license l> · image search "words" · image list [t]
                                         keep a real image in the topic (offline, credited): ![caption](media:<file>)
bin/learn check [t]                      validate topic files (JSON, skill ids, links, map) after editing
bin/learn commit "message" [-- path…]    commit the learning data (data/ is its own git repo); with paths, only
                                         those (relative to it), so a job and a tutor don't commit each other's files
bin/learn handoff [--topic t] [--reason s]   end this tutor session; a fresh one takes over
bin/learn new <slug> "Title"             create an empty topic (the learner usually does this in the browser)
bin/learn import <transcript.jsonl>... --topic t   import old terminal sessions

Data lives in ${S.ROOT} (set LEARN_HOME to use another directory).`);
};

commands.serve = () => { S.ensureHome(); require('../app/server').start(); };

// A throwaway copy of the fixture topics (or, with --real, of your own) served on another port with
// the fake tutor: for trying UI changes without touching real data or a real tutor session.
commands.demo = () => {
  const f = flags(argv, { real: 'bool', port: 'string', keep: 'bool', 'no-open': 'bool', empty: 'bool' });
  const os = require('os');
  const home = fs.mkdtempSync(path.join(os.tmpdir(), 'learn-demo-'));
  const src = f.real ? S.TOPICS : path.join(S.CODE, 'test', 'fixture', 'topics');
  if (!f.empty) fs.cpSync(src, path.join(home, 'topics'), { recursive: true });
  const learner = f.real ? S.LEARNER : path.join(S.CODE, 'test', 'fixture', 'learner');
  if (!f.empty && fs.existsSync(learner)) fs.cpSync(learner, path.join(home, 'learner'), { recursive: true });
  const port = f.port || '4748';
  console.log(`demo data: ${home}${f.keep ? ' (kept)' : ' (deleted on exit)'}\nfake tutor: type anything, it echoes. Ctrl+C to stop.`);
  const env = { ...process.env, LEARN_HOME: home, LEARN_PORT: port, LEARN_CLAUDE: path.join(S.CODE, 'test', 'fake-tutor.mjs'), LEARN_NO_GIT: '1',
    CLAUDE_CONFIG_DIR: path.join(home, 'claude'), LEARN_HANDOFF_TOKENS: process.env.LEARN_HANDOFF_TOKENS || '400000' };
  const topic = f._[0] || (f.empty ? null : f.real ? defaultTopic() : 'demo');
  const child = spawn(process.execPath, [__filename, 'start', ...(topic ? [topic] : []), ...(f['no-open'] ? ['--no-open'] : [])], { stdio: 'inherit', env });
  process.on('SIGINT', () => {});
  child.on('exit', code => { if (!f.keep) fs.rmSync(home, { recursive: true, force: true }); process.exit(code ?? 0); });
};

commands.test = () => {
  const child = spawn(process.execPath, [path.join(S.CODE, 'test', 'acceptance.mjs'), ...argv], { stdio: 'inherit' });
  child.on('exit', code => process.exit(code ?? 1));
};

commands.away = () => require('../app/jobs').cli(argv);
commands.share = () => { try { require('../app/share').cli(argv); } catch (e) { die(e.message); } };

// `bin/learn` is the only command the learner needs, and running it again is harmless: if the
// tutor is already running it just opens the browser.
commands.start = async () => {
  const f = flags(argv, { c: 'bool', continue: 'bool', 'no-open': 'bool' });
  if (T.launcherAlive()) {
    const url = `http://localhost:${S.PORT}/${f._[0] ? '#/' + f._[0] : ''}`;
    console.log(`learn is already running (tutor launcher pid ${T.readSession().launcherPid}): ${url}`);
    if (!f['no-open']) { try { require('child_process').execFileSync('open', [url]); } catch {} }
    return;
  }
  await require('../app/launcher').start({
    topic: f._[0] || null, resume: !!(f.c || f.continue), open: !f['no-open'], claudeArgs: f['--'] || [],
  });
};

// ---------------------------------------------------------------- resume: the startup bundle
commands.resume = () => {
  const f = flags(argv, { topic: 'string', messages: 'string' });
  const slug = topicOf(f, true);
  const sess = T.readSession();
  if (process.env.LEARN_SESSION && sess?.id === process.env.LEARN_SESSION && sess.topic !== slug) T.writeSession({ ...sess, topic: slug });
  const meta = S.loadTopicMeta(slug), dir = S.topicDir(slug);
  const J = S.readJournal(slug);
  const appTalk = S.metaIds(J);
  const out = [];
  const sec = (title, body) => { if (body && String(body).trim()) out.push(`\n## ${title}\n${String(body).replace(/\s+$/, '')}`); };

  const lastUser = [...J].reverse().find(e => e.role === 'user' && !e.imported && !appTalk.has(e.id));
  const last = [...J].reverse().find(e => e.kind !== 'session' && e.kind !== 'tag');
  const gapMs = last ? Date.now() - Date.parse(last.ts) : null;
  let advice;
  if (!meta.skills?.length) advice = 'NEW TOPIC: no skill tree yet. Follow docs/bootstrap.md (first reply fast: one line + diagnostic question 1; then write the tree).';
  else if (gapMs == null) advice = 'No messages yet: introduce the plan briefly and ask the first question.';
  else {
    const size = gapMs < 8 * 3600e3 ? 'hours: no refresher, re-ask the pending question if it got lost'
      : gapMs < 7 * 86400e3 ? 'a day or more: a short recap linking the earlier messages + one spaced-review question from the due list'
      : 'a week or more: re-check the prerequisite blocks of the current focus before moving on';
    advice = `Just handle the learner's message; don't post an unasked recap. If they pressed "welcome back" in the UI (an action asking for a recap), size it by the gap (${size}).`;
  }
  out.push(`# Resume: ${meta.title} (${slug})`);
  out.push(`Last activity: ${last ? `${last.ts.slice(0, 16).replace('T', ' ')} (${ago(gapMs)})` : 'none'}${lastUser ? ` · last learner message ${lastUser.id}` : ''}`);
  out.push(`→ ${advice}`);
  if (meta.goal) out.push(`Goal (learner's words): ${meta.goal}`);

  const prof = S.readText(path.join(S.LEARNER, 'profile.md'), '');
  const know = S.readText(path.join(S.LEARNER, 'knowledge.md'), '');
  const meaty = t => t.split('\n').some(l => /^\s*[-*]|^\w/.test(l) && !/^(Who|What|Keep|Shared)/.test(l));
  // drop the title and intro paragraph, demote headings so they nest under this section
  const body = t => t.replace(/^# [^\n]*\n[\s\S]*?(?=^## )/m, '').replace(/^## /gm, '### ').replace(/^### [^\n]*\n\s*(?=### |$(?![\s\S]))/gm, '');
  sec('Learner profile (data/learner/profile.md, all topics)', meaty(prof) ? body(prof) : '(empty: add what you learn about how they like to be taught)');
  if (meaty(know)) sec('Knowledge across topics (data/learner/knowledge.md)', body(know));

  const prog = S.readText(path.join(dir, 'progress.md'), '');
  const rh = prog.match(/^## Resume here[^\n]*\n([\s\S]*?)(?=^## |(?![\s\S]))/m);
  const stale = require('../app/check').staleNoteRefs(slug);
  sec('Resume here (progress.md)', (rh ? rh[1] : prog).replace(/\s+$/, '') + (stale.length ? `\n\n⚠ Possibly stale: it mentions note${stale.length > 1 ? 's' : ''} already closed (notes.json is current; rewrite "Resume here"):\n` +
    stale.map(r => `  ${r.id} closed ${r.closed || '?'}${r.outcome ? ': ' + r.outcome.slice(0, 120) : ''}  (line ${r.line})`).join('\n') : ''));

  const tree = [];
  const notes = S.readNotes(slug);
  for (const fd of meta.foundations || []) {
    const open = notes.items.filter(n => n.status === 'open' && n.skill === fd.id).length;
    tree.push(`  @${fd.id}  ${fd.name}  ${fd.level ?? '?'}${fd.topic ? `  (topic ${fd.topic})` : ''}  [foundation]${open ? `  (${open} note${open > 1 ? 's' : ''})` : ''}`);
  }
  S.walkSkills(meta.skills, (s, parent) => {
    const kids = s.children?.length;
    const lv = kids ? (s.children.reduce((a, c) => a + (c.level || 0), 0) / s.children.length).toFixed(1) : String(s.level ?? 0);
    const open = notes.items.filter(n => n.status === 'open' && n.skill === String(s.id)).length;
    tree.push(`${parent ? '    ' : '  '}${s.id}  ${s.name}  ${lv}${s.needs?.length ? `  needs ${s.needs.join(',')}` : ''}${open ? `  (${open} note${open > 1 ? 's' : ''})` : ''}${meta.focus === s.id ? '   ◀ FOCUS' : ''}`);
  });
  sec(`Skill tree (target ${meta.target}; focus ${meta.focus || '-'}; levels via \`bin/learn level\`)`, tree.join('\n'));

  const pend = S.pendingQuestion(J);
  if (pend) {
    const q = (pend.text.match(/^:::question[^\n]*\n([\s\S]*?)^:::\s*$/m) || [])[1] || pend.text.slice(-500);
    const answered = J.filter(e => e.role === 'user' && e.ts > pend.ts && !e.imported && !appTalk.has(e.id));
    sec(`Pending question ${pend.id}${pend.skills?.length ? ` (skill ${pend.skills.join(',')})` : ''}`, q.trim() +
      (pend.expect ? `\nGood answer needs: ${pend.expect}` : '\n(no rubric stored: post questions with --expect "…")') +
      (answered.length ? `\nLearner messages since: ${answered.map(e => `${e.id} [${e.kind}]`).join(', ')}` : ''));
  } else sec('Pending question', 'none');

  const today = S.localDate();
  const open = notes.items.filter(n => n.status === 'open');
  const fids = new Set((meta.foundations || []).map(x => x.id));
  const fmt = n => `  ${n.id}${n.skill ? ` [${fids.has(n.skill) ? '@' : ''}${n.skill}]` : ''} ${n.text}${n.due ? ` (due ${n.due}${n.due <= today ? ', DUE' : ''})` : ''}${n.ref ? ` (msg:${n.ref})` : ''}`;
  const byKind = k => open.filter(n => n.kind === k).sort((a, b) => (a.due || '9') < (b.due || '9') ? -1 : 1).map(fmt).join('\n');
  sec('Notes: spaced review (re-test; close with `bin/learn note done <id> "outcome"`)', byKind('review'));
  sec('Notes: open misconceptions', byKind('misconception'));
  sec('Notes: suspected holes (probe when relevant, not urgent)', byKind('hole'));
  sec('Notes: parked learner questions', byKind('parked'));

  const G = S.readGlossary(slug), gl = G.map(g => g.term);
  sec(`Glossary terms (${gl.length}; add with \`bin/learn term add\`, see one with \`term show\`)`, gl.join(', ') || '(none yet)');
  // term pages: the learner's encyclopedia, written during the lesson (docs/protocol.md "Term pages")
  if (G.length) {
    const TP = S.readTermPages(slug), has = g => !!S.pageForTerm(g, TP);
    const near = new Set(); if (meta.focus) { const fs0 = S.findSkill(meta, meta.focus); if (fs0) S.walkSkills([fs0], x => near.add(String(x.id))); }
    const todo = G.filter(g => !has(g) && g.skills.some(x => near.has(String(x)))).map(g => g.term);
    sec(`Term pages (${G.filter(has).length} of ${G.length} terms have one; \`bin/learn term pages\` for the most-mentioned without)`,
      todo.length ? `Focus ${meta.focus} terms without a page: ${todo.join(', ')}. Write each when you next teach it (after replying).` : 'Every focus term has a page.');
  }
  const pages = S.readPages(slug);
  if (pages.length) sec('Wiki pages (wiki:page/<name>)', pages.map(p => `${p.name}: ${p.title}`).join('\n'));
  sec('Visual language: draw these things in these colours, always (ctx.color(key), {{text|key}}, ctx.legend([keys]); add with `bin/learn legend set`)',
    legendLines(meta) || '(no legend yet: when a drawing introduces something that will recur, give it a colour with `bin/learn legend set <key> <#hex> "label"`)');
  const fb = S.openFeedback().length;
  if (fb) out.push(`\n(${fb} open feedback item(s) in data/feedback.md for the builder: not your job mid-lesson)`);

  // the lesson only: app talk (META messages, replies posted with --meta, tagged entries) is left out
  const n = Number(f.messages) || 6;
  const shown = e => (['message', 'answer', 'ask', 'action', 'start', 'meta'].includes(e.kind) || e.kind === 'grade');
  const vis = J.filter(e => shown(e) && !appTalk.has(e.id)).slice(-n);
  const skipped = vis.length ? J.filter(e => shown(e) && appTalk.has(e.id) && e.ts >= vis[0].ts).length : 0;
  sec(`Last ${vis.length} journal entries (more: \`bin/learn recent 20\`, \`bin/learn show <id>\`)`, vis.map(e => {
    if (e.kind === 'grade') return `${e.id} [grade] ${e.verdict} on ${e.target} (${e.skill || '-'}) ${e.note || ''}`;
    const text = e.role === 'tutor' && e.text.length > 900 ? e.text.slice(0, 450) + ' … ' + e.text.slice(-400) : e.text;
    return `${e.id} [${e.role === 'tutor' ? 'tutor' : e.kind}]\n${text.replace(/^/gm, '  ')}`;
  }).join('\n') + (skipped ? `\n(+ ${skipped} app-talk entr${skipped > 1 ? 'ies' : 'y'} since ${vis[0].id}, not shown: \`bin/learn recent\` has them)` : ''));
  const q = S.inboxIds().length;
  if (q) out.push(`\n(${q} learner message(s) queued: \`bin/learn wait\` returns them right away)`);
  console.log(out.join('\n'));
};

// ---------------------------------------------------------------- the loop
commands.wait = async () => {
  S.ensureDir(S.INBOX);
  const mine = process.env.LEARN_SESSION || null;
  const stale = () => { const cur = T.readSession(); return mine && cur && cur.id !== mine; };
  if (stale()) { console.log('(this tutor session was replaced by a newer one; not listening)'); return; }
  process.on('exit', T.registerListener(mine));
  for (const sig of ['SIGTERM', 'SIGINT', 'SIGHUP']) process.on(sig, () => process.exit(130));

  const claim = () => {
    const files = fs.readdirSync(S.INBOX).filter(f => f.endsWith('.json')).sort();
    const got = [];
    for (const f of files) {
      const src = path.join(S.INBOX, f), dst = src + '.' + process.pid;
      try { fs.renameSync(src, dst); } catch { continue; }    // someone else took it
      try { got.push(JSON.parse(fs.readFileSync(dst, 'utf8'))); } catch {}
      fs.unlinkSync(dst);
    }
    return got;
  };
  let msgs = claim();
  while (!msgs.length) {
    await new Promise(res => {
      let w; const t = setTimeout(done, 1000);
      function done() { clearTimeout(t); if (w) w.close(); res(); }
      try { w = fs.watch(S.INBOX, done); } catch {}
    });
    if (stale()) { console.log('(this tutor session was replaced by a newer one; stop listening)'); return; }
    msgs = claim();
  }
  // tell the server the messages were picked up (UI shows "thinking")
  try { await api('POST', '/api/picked', { ids: msgs.map(m => m.id) }); } catch {}
  let handoff = false;
  for (const m of msgs) {
    const bits = [`id=${m.id}`, `topic=${m.topic}`];
    if (m.replyTo) bits.push(`replying-to=${m.replyTo}`);
    if (m.quote) bits.push(`quote=${m.quote}`);
    if (m.kind === 'meta') bits.push('(about the app, not the lesson: reply with `post --meta`; already in feedback.md for the builder)');
    console.log(`── ${String(m.kind).toUpperCase()}  ${bits.join('  ')} ──`);
    console.log(m.text);
    console.log();
    if (T.isFreshTutorAction(m)) handoff = true;
  }
  // which topic is this session for? A message for another topic means a topic switch.
  const sess = T.readSession();
  const mineSess = sess && (!mine || sess.id === mine) ? sess : null;
  const other = msgs.find(m => m.topic && mineSess && mineSess.topic && m.topic !== mineSess.topic);
  if (mineSess && !mineSess.topic && msgs[0]?.topic) {
    T.writeSession({ ...mineSess, topic: msgs[0].topic });
    const at = new Date(Date.parse(msgs[0].ts || new Date().toISOString()) - 1).toISOString();
    S.appendJournal(msgs[0].topic, [{ role: 'system', kind: 'session', text: 'Session started', ts: at }]);
    console.log(`(first message for topic ${msgs[0].topic}: run \`bin/learn resume ${msgs[0].topic}\` before replying${msgs.some(m => m.kind === 'start') ? '; START = new topic, follow docs/bootstrap.md' : ''})`);
  }
  if (other) {
    console.log(`── TOPIC SWITCH ── The learner is now in topic "${other.topic}"${other.kind === 'start' ? ' (a NEW topic)' : ''}; this session is for "${mineSess.topic}". Don't reply. Instead:
  1. Update "Resume here" in ${mineSess.topic}'s progress.md if anything changed, and \`bin/learn commit "…"\`.
  2. Run \`bin/learn handoff --topic ${other.topic} --reason "topic switch"\`. A fresh tutor picks up ${other.topic} with these messages queued for it.`);
    return;
  }
  const ctx = mine && T.contextTokens(mine);
  const turns = !ctx && mineSess ? S.readJournal(mineSess.topic || msgs[0].topic).filter(e => e.role === 'tutor' && e.kind === 'message' && e.ts > mineSess.startedAt).length : 0;
  if (handoff) console.log(HANDOFF_STEPS('The learner asked for a fresh tutor.'));
  else if (ctx && ctx.tokens >= T.HANDOFF_TOKENS)
    console.log(HANDOFF_STEPS(`Your context is at ~${Math.round(ctx.tokens / 1000)}k tokens (handoff threshold ${Math.round(T.HANDOFF_TOKENS / 1000)}k). Reply to the message above first.`));
  else if (!ctx && turns >= T.HANDOFF_MESSAGES)
    console.log(HANDOFF_STEPS(`This session has posted ${turns} messages (handoff after ${T.HANDOFF_MESSAGES} when the context size is unknown). Reply to the message above first.`));
  else console.log(`(reply: bin/learn post … ; then re-run \`bin/learn wait\` in the background${ctx ? `; context ~${Math.round(ctx.tokens / 1000)}k tokens` : ''})`);
};
const HANDOFF_STEPS = why => `── HANDOFF ── ${why} Then, instead of re-arming wait:
  1. Update progress.md "Resume here": where we are, what you planned next, the learner's current state of mind. (The pending question and its rubric come from the journal if you posted it with --expect; reviews/holes/parked from notes.json.) Update skill summaries if you taught something new.
  2. \`bin/learn commit "…"\` if there are changes.
  3. Run \`bin/learn handoff\`. A fresh tutor session takes over automatically; the learner sees "switching tutor".`;

commands.handoff = async () => {
  const f = flags(argv, { topic: 'string', reason: 'string', force: 'bool' });
  if (!T.launcherAlive()) die('no bin/learn launcher is running, so nothing can start a fresh tutor. Ask the learner to restart `bin/learn` in a terminal.');
  T.requestHandoff({ reason: f.reason || 'context refresh', topic: f.topic || defaultTopic(), force: !!f.force, by: process.env.LEARN_SESSION || null });
  console.log('handoff requested: this session ends in a moment and a fresh tutor takes over. Do nothing else.');
};

// Claude Code SessionStart hook (matcher "compact"): if a web tutor session was just compacted,
// remind it how the loop works. Prints nothing for any other session.
function readHookInput() { try { return JSON.parse(readStdin() || '{}'); } catch { return {}; } }
commands.hook = () => {
  const input = readHookInput();
  const cur = T.readSession();
  if (!cur || !input.session_id || input.session_id !== cur.id) return;
  console.log(`You are the web tutor started by bin/learn (session ${cur.id}); your context was just compacted.
Before anything else: re-read docs/protocol.md (the loop), run \`bin/learn resume${cur.topic ? ' ' + cur.topic : ''}\`, and make sure \`bin/learn wait\` is running in the background (start it if unsure — a stale one exits by itself).
Then consider \`bin/learn handoff\` after your next reply: a fresh session is cleaner than a compacted one.`);
};

commands.post = async () => {
  const f = flags(argv, { topic: 'string', skill: 'string', grade: 'string', 'grade-skill': 'string', note: 'string', file: 'string', expect: 'string', force: 'bool', meta: 'bool' });
  if (f.meta && (f.grade || f.skill || f['grade-skill'] || f.expect)) die('--meta is a reply about the app, not the lesson: no --grade, --skill or --expect');
  const text = (f.file ? fs.readFileSync(f.file, 'utf8') : readStdin()).replace(/\s+$/, '');
  if (f.meta && !text) die('nothing to post (markdown on stdin)');
  const verdicts = ['correct', 'partial', 'wrong', 'skipped'];
  if (f.grade && !verdicts.includes(f.grade)) die(`--grade must be one of ${verdicts.join('|')}`);
  if (!text && !f.grade) die('nothing to post (markdown on stdin)');
  const topic = f.topic || defaultTopic();
  if (!topic) die('no topic; pass --topic');
  if (!S.listTopics().includes(topic)) die(`unknown topic ${topic}`);
  const skills = list(f.skill);
  const meta = S.loadTopicMeta(topic);
  for (const id of [...skills, f['grade-skill']].filter(Boolean)) if (!S.findSkill(meta, id)) die(`no skill ${id} in ${topic}`);
  const question = !f.meta && S.hasQuestion(text);
  if (f.meta && S.hasQuestion(text)) die('not posted: a --meta reply can\'t carry a :::question (it would become the lesson\'s pending question). Ask in prose; the learner answers with "About the app".');
  if (text) {
    const probs = require('../app/check').linkChecker(topic)(text);
    const errs = probs.filter(p => p.error);
    for (const p of probs) console.error(`${p.error ? 'error' : 'warning'}: link ${p.type}:${p.id}: ${p.why}`);
    if (errs.length && !f.force) die('not posted: fix the links above (or pass --force). `bin/learn msgs --skill <id>` lists real message ids.');
    // a drawing that doesn't parse would reach the learner as an error box
    const viz = require('../app/check').vizProblems(text);
    for (const p of viz) console.error(`error: viz ${p.type} (line ${p.line} of the message): ${p.why}`);
    if (viz.length && !f.force) die('not posted: fix the viz block(s) above (or pass --force).');
    if (question && (text.match(/^:::question\b/gm) || []).length > 1) console.error('warning: more than one :::question block; only one is tracked as pending');
    // a question asked in prose isn't tracked: the answer box doesn't show it and the answer isn't linked to it
    const lastPara = text.replace(/```[\s\S]*?```/g, '').trim().split(/\n\s*\n/).pop() || '';
    if (!question && !f.meta && /\?\s*$/.test(lastPara) && !f.force) die('not posted: the message ends with a question outside a :::question block, so the learner won\'t see it above the answer box. Put it in :::question … ::: (with --expect), or pass --force if it is rhetorical.');
    if (f.expect && !question) console.error('warning: --expect given but the message has no :::question block');
  }

  const entries = [];
  // a lesson message replies to the learner's last lesson message; a --meta one to their last message
  const lastUser = S.lastEntry(e => e.topic === topic && e.role === 'user' && !e.imported && (f.meta || e.kind !== 'meta'), [topic]);
  if (f.grade) {
    const target = S.lastEntry(e => e.topic === topic && e.role === 'user' && e.kind === 'answer', [topic]);
    if (!target) die('no answer to grade');
    entries.push({ role: 'tutor', kind: 'grade', target: target.id, questionId: target.replyTo || null,
      verdict: f.grade, skill: f['grade-skill'] || skills[0] || null, note: f.note || '' });
  }
  if (text) entries.push({ role: 'tutor', kind: 'message', text, skills, question,
    replyTo: lastUser ? lastUser.id : null, ...(f.expect && question ? { expect: f.expect } : {}), ...(f.meta ? { meta: true } : {}) });

  let saved;
  if (await serverUp()) saved = await api('POST', '/api/append', { topic, entries });
  else saved = S.appendJournal(topic, entries);
  for (const e of saved) console.log(`posted ${e.meta ? 'meta ' : ''}${e.kind} ${e.id}${e.kind === 'grade' ? ` (${e.verdict} → ${e.target})` : ''}${e.question ? ` [question${e.expect ? ' + rubric' : ', no --expect rubric'}]` : ''}`);
  // a reminder for the bookkeeping step: bold phrases (new terms, usually) not in the glossary yet
  if (text && !f.meta) {
    const miss = require('../app/check').missingTerms(topic, { texts: [{ text }] }).missing.map(g => `"${g.phrase}"`);
    if (miss.length) console.log(`glossary: bold here but not in the glossary: ${miss.join(', ')}. Add the real terms afterwards (\`bin/learn term add\`); ignore emphasis.`);
    // the wiki grows during the lesson, not later: each term this message taught gets its page now
    const taught = require('../app/check').taughtTerms(topic, text);
    if (taught.length) console.log(`term pages (after re-arming wait; docs/protocol.md "Term pages"): put what this message taught into the article of ${taught.map(t => `"${t.term}" (${t.page ? 'extend ' + rel(t.path) : 'new: ' + rel(t.path)})`).join(', ')}${miss.length ? ', and of the new terms above' : ''}. Skip a term only if this message added nothing about it.`);
  }
};

// ---------------------------------------------------------------- state commands
commands.level = async () => {
  const f = flags(argv, {});
  const topic = topicOf(f, true);
  const [skill, lvl, ...reason] = f._;
  if (!skill || lvl == null) die('usage: level [topic] <skill> <0-5> "reason"');
  if (!(Number(lvl) >= 0 && Number(lvl) <= 5)) die('level must be 0-5');
  const meta = S.loadTopicMeta(topic);
  const fd = (meta.foundations || []).find(x => x.id === skill.replace(/^@/, ''));
  if (fd) { fd.level = Number(lvl); S.saveTopicMeta(topic, meta); console.log(`${topic} foundation ${fd.id}: level ${lvl}`); return; }
  const e = (await serverUp())
    ? await api('POST', '/api/level', { topic, skill, level: Number(lvl), reason: reason.join(' ') })
    : S.setLevel(topic, skill, lvl, reason.join(' '));
  console.log(`${topic} ${skill}: ${e.from} → ${e.to}`);
};

commands.focus = () => {
  const f = flags(argv, {});
  const topic = topicOf(f, true);
  const meta = S.loadTopicMeta(topic);
  if (!f._[0]) { console.log(meta.focus || '(none)'); return; }
  if (!S.findSkill(meta, f._[0])) die(`no skill ${f._[0]} in ${topic}`);
  meta.focus = f._[0];
  S.saveTopicMeta(topic, meta);
  console.log(`${topic} focus: ${f._[0]}`);
};

commands.note = () => {
  const f = flags(argv, { topic: 'string', skill: 'string', ref: 'string', due: 'string', all: 'bool' });
  const sub = f._.shift();
  const topic = topicOf(f);
  if (sub === 'done' || sub === 'close') {
    const [id, ...outcome] = f._;
    if (!id) die('usage: note done <id> ["outcome"]');
    const it = S.closeNote(topic, id, outcome.join(' '));
    console.log(`closed ${it.id} (${it.kind}): ${it.text}`);
  } else if (sub === 'list' || !sub) {
    for (const n of S.readNotes(topic).items.filter(n => f.all || n.status === 'open'))
      console.log(`${n.id} ${n.kind}${n.skill ? ` [${n.skill}]` : ''}${n.status === 'done' ? ' (done' + (n.outcome ? ': ' + n.outcome : '') + ')' : ''}${n.due ? ` due ${n.due}` : ''}: ${n.text}`);
  } else {
    // a skill id, or a foundation id (@chem or chem): cross-topic holes usually live in foundations
    if (f.skill) {
      const meta = S.loadTopicMeta(topic), fid = f.skill.replace(/^@/, '');
      if ((meta.foundations || []).some(x => x.id === fid)) f.skill = fid;
      else if (!S.findSkill(meta, f.skill)) die(`no skill or foundation ${f.skill} in ${topic} (foundations: ${(meta.foundations || []).map(x => '@' + x.id).join(', ') || 'none'})`);
    }
    if (f.ref && !S.findEntry(f.ref, topic)) die(`no message ${f.ref}`);
    const it = S.addNote(topic, { kind: sub, text: f._.join(' '), skill: f.skill, ref: f.ref, due: S.parseDue(f.due) });
    console.log(`added ${it.id} (${it.kind}${it.skill ? ', ' + it.skill : ''}${it.due ? ', due ' + it.due : ''})`);
  }
};

commands.summary = () => {
  const f = flags(argv, { topic: 'string' });
  const topic = topicOf(f, true);
  const [id, ...rest] = f._;
  const meta = S.loadTopicMeta(topic), s = id && S.findSkill(meta, id);
  if (!s) die('usage: summary [topic] <skill> "- bullet"');
  const add = rest.join(' ').trim();
  if (!add) { console.log(s.summary || '(no summary)'); return; }
  const probs = require('../app/check').linkChecker(topic)(add).filter(p => p.error);
  if (probs.length) die(probs.map(p => `link ${p.type}:${p.id}: ${p.why}`).join('\n'));
  s.summary = (s.summary ? s.summary.replace(/\s+$/, '') + '\n' : '') + (add.startsWith('-') ? add : '- ' + add);
  S.saveTopicMeta(topic, meta);
  console.log(`${topic} ${id} summary: ${s.summary.split('\n').length} line(s)`);
};

// a path relative to the working directory when it's inside it (shorter to read), else absolute
const rel = p => { const r = path.relative(process.cwd(), p); return r && !r.startsWith('..') ? r : p; };
commands.term = () => {
  const f = flags(argv, { topic: 'string', skill: 'string', short: 'string', full: 'string', aliases: 'string', parts: 'string', see: 'string', refs: 'string', size: 'string', body: 'string', n: 'string' });
  const sub = f._.shift();
  const topic = topicOf(f);
  const name = f._.join(' ');
  if (sub === 'show') {
    const n = name.toLowerCase();
    const g = S.readGlossary(topic).find(t => t.term.toLowerCase() === n || t.aliases.some(a => a.toLowerCase() === n));
    if (!g) die(`no term "${name}"`);
    console.log([`## ${g.term}`, g.full && `full: ${g.full}`, g.aliases.length && `aliases: ${g.aliases.join(', ')}`, g.skills.length && `skill: ${g.skills.join(', ')}`,
      g.parts.length && `parts: ${g.parts.join(', ')}`, g.see.length && `see: ${g.see.join(', ')}`, g.refs.length && `refs: ${g.refs.join(', ')}`, g.short, g.body && '\n' + g.body].filter(Boolean).join('\n'));
    const pg = S.pageForTerm(g, S.readTermPages(topic));
    console.log(pg ? `\npage: ${rel(path.join(S.termPagesDir(topic), pg.name + '.md'))} (updated ${pg.mtime.slice(0, 10)}, ${pg.text.length} chars)\n\n${pg.text}`
      : `\npage: none yet (write it as ${rel(S.termPagePath(topic, g.term))}; docs/formats.md, "terms/")`);
  } else if (sub === 'pages') {
    // which terms have a page, and the most-mentioned ones that don't (candidates for one)
    const G = S.readGlossary(topic), P = S.readTermPages(topic);
    const { termMatcher } = require('../web/js/terms.js');
    const m = termMatcher(G), count = new Map(), last = new Map();
    const J = S.readJournal(topic), meta = S.metaIds(J);
    for (const e of J) if (e.role === 'tutor' && e.kind === 'message' && e.text && !meta.has(e.id))
      for (const term of new Set(m.find(e.text.replace(/```[\s\S]*?```|`[^`\n]*`/g, ' ')).map(x => x.entry.term))) { count.set(term, (count.get(term) || 0) + 1); last.set(term, e.ts); }
    const withP = G.map(g => ({ g, p: S.pageForTerm(g, P) })).filter(x => x.p);
    console.log(`${topic}: ${withP.length} term page(s) in ${rel(S.termPagesDir(topic))}/`);
    for (const { g, p } of withP) {
      const stale = last.get(g.term) && last.get(g.term) > p.mtime;
      console.log(`  ${g.term.padEnd(28)} ${p.name}.md  updated ${p.mtime.slice(0, 10)}${stale ? `  (mentioned since: last ${last.get(g.term).slice(0, 10)})` : ''}`);
    }
    const cand = G.filter(g => !S.pageForTerm(g, P) && count.get(g.term)).sort((a, b) => count.get(b.term) - count.get(a.term)).slice(0, Number(f.n) || 15);
    if (cand.length) console.log(`Most-mentioned terms without a page (messages): ${cand.map(g => `${g.term} (${count.get(g.term)})`).join(', ')}`);
  } else if (sub === 'add') {
    if (f.skill) for (const s of list(f.skill)) if (!S.findSkill(S.loadTopicMeta(topic), s)) die(`no skill ${s} in ${topic}`);
    const body = f.body === '-' ? readStdin() : f.body || '';
    S.addTerm(topic, { term: name, short: f.short, body, full: f.full, skill: f.skill, aliases: list(f.aliases), parts: list(f.parts), see: list(f.see), refs: list(f.refs), size: f.size });
    const missing = list(f.parts).filter(p => !S.readGlossary(topic).some(g => [g.term, ...g.aliases].some(x => x.toLowerCase() === p.toLowerCase())));
    console.log(`added "${name}" to ${topic}/glossary.md${missing.length ? ` (parts not in the glossary yet: ${missing.join(', ')})` : ''}`);
  } else die('usage: term add|show|pages …');
};
// The topic's visual language: one colour per recurring thing, in topic.json "legend".
const legendLines = meta => (Array.isArray(meta.legend) ? meta.legend : []).map(x => `  ${String(x.key).padEnd(16)} ${String(x.color).padEnd(9)} ${x.label || ''}${x.term ? `  (term: ${x.term})` : ''}`).join('\n');
commands.legend = () => {
  const f = flags(argv, { topic: 'string', term: 'string' });
  const topic = topicOf(f);
  const [sub, key, color, ...label] = f._;
  if (sub === 'set') {
    if (!key || !color) die('usage: legend [t] set <key> <#color> "label" [--term name]');
    if (f.term && !S.readGlossary(topic).some(g => [g.term, ...g.aliases].some(x => x.toLowerCase() === f.term.toLowerCase()))) die(`no glossary term "${f.term}"`);
    const r = S.setLegend(topic, { key, color, label: label.join(' ').trim(), term: f.term });
    console.log(`${r.replaced ? 'updated' : 'added'} ${key} ${color} "${r.entry.label}" in ${topic}'s legend${r.clash ? `\nwarning: ${color} is also "${r.clash.label}" (${r.clash.key}); one colour should mean one thing` : ''}`);
  } else if (sub === 'rm') {
    if (!key) die('usage: legend [t] rm <key>');
    S.removeLegend(topic, key);
    console.log(`removed ${key} from ${topic}'s legend`);
  } else if (!sub) {
    const lines = legendLines(S.loadTopicMeta(topic));
    console.log(lines ? `${topic} legend (use {{text|key}} in prose, ctx.color(key) and ctx.legend([keys]) in drawings):\n${lines}` : `${topic}: no legend yet. Add one: bin/learn legend set <key> <#color> "label" [--term name]`);
  } else die('usage: legend [t] [set <key> <#color> "label" [--term name] | rm <key>]');
};

// Real images in the topic (app/media.js): download from Wikimedia Commons, or add a local file,
// into topics/<t>/media/ with author and licence; shown with ![caption](media:<file>).
commands.image = async () => {
  const f = flags(argv, { topic: 'string', name: 'string', width: 'string', author: 'string', license: 'string', source: 'string', n: 'string' });
  const M = require('../app/media');
  if (f._[0] === 'search') {
    const q = f._.slice(1).join(' ').trim();
    if (!q) die('usage: image search "words" [--n 8]');
    const hits = await M.search(q, Number(f.n) || 8);
    if (!hits.length) { console.log('(nothing found on Commons)'); return; }
    for (const x of hits) console.log(`${x.title}  ${x.width}×${x.height} ${String(x.mime || '').replace('image/', '')}  ${x.license || '?'} · ${x.author || '?'}${x.description ? `\n    ${x.description}` : ''}`);
    console.log('\nDownload one: bin/learn image "File:…"');
    return;
  }
  if (f._[0] === 'list') {
    f._.shift();
    const topic = topicOf(f, true);
    const idx = S.readMedia(topic);
    for (const [name, m] of Object.entries(idx)) console.log(`${name}  ${m.license} · ${m.author}  (${m.title})`);
    if (!Object.keys(idx).length) console.log('(no images yet)');
    return;
  }
  const topic = f._.length > 1 ? topicOf(f, true) : topicOf(f);
  const src = f._.join(' ').trim();
  if (!src) die('usage: image [t] <Commons file or URL | local file> [--name n] [--width 1280] · image search "words" · image list [t]');
  const local = fs.existsSync(src) && fs.statSync(src).isFile();
  if (local && (!f.author || !f.license)) die('a local file needs --author and --license (and --source if it has one)');
  const r = local ? M.addLocal(topic, src, { name: f.name, author: f.author, license: f.license, source: f.source })
    : await M.addCommons(topic, src, { name: f.name, width: Number(f.width) || 1280 });
  console.log(`saved ${topic}/media/${r.name}${r.width ? ` (${r.width}×${r.height})` : ''} · ${r.license} · ${r.author}
show it: ![caption](media:${r.name})`);
};

// Bold phrases in recent tutor messages that name no glossary term or alias: terms the tutor
// introduced but forgot to add (app/check.js missingTerms). Read-only.
commands['terms-missing'] = () => {
  const f = flags(argv, { topic: 'string', last: 'string', all: 'bool' });
  const topic = topicOf(f, true);
  const last = f.all ? Infinity : Number(f.last) || 20;
  const r = require('../app/check').missingTerms(topic, { last });
  const span = f.all ? 'all tutor messages' : r.scanned === 1 ? 'the last tutor message' : `the last ${r.scanned} tutor messages`;
  if (!r.missing.length && !r.partial.length) { console.log(`${topic}: every bold phrase in ${span} is a glossary term or alias.`); return; }
  console.log(`${topic}: bold phrases in ${span} that are no glossary term or alias (newest first).
Add the real terms (\`bin/learn term add "name" --short "…"\`, or --aliases on an existing one); ignore emphasis.`);
  const w = Math.min(32, Math.max(...r.missing.map(g => g.phrase.length), 8));
  for (const g of r.missing) console.log(`  ${g.phrase.padEnd(w)}  ${g.ids.slice(-3).join(', ')}${g.ids.length > 3 ? ` (+${g.ids.length - 3})` : ''}`);
  if (r.partial.length) console.log(`Contain a known term (add only if it's a term of its own): ${r.partial.map(g => `${g.phrase} (${g.has.join(', ')})`).join(' · ')}`);
};
commands.terms = () => { const f = flags(argv, { topic: 'string' }); console.log(S.readGlossary(topicOf(f, true)).map(g => g.term).join(', ')); };

// The skill tree as an indented outline (round-trips through `tree --set`):
//   @linalg Linear algebra: vectors, dot products   ← foundation (outside this topic)
//   4 Attention
//     4.1 Q, K, V & dot-product scores <- 2.1, linalg
commands.tree = () => {
  const f = flags(argv, { topic: 'string', set: 'bool', prune: 'bool' });
  const topic = topicOf(f, true);
  const meta = S.loadTopicMeta(topic);
  if (!f.set) {
    const lines = (meta.foundations || []).map(x => `@${x.id} ${x.name}`);
    S.walkSkills(meta.skills, (s, p) => lines.push(`${p ? '  ' : ''}${s.id} ${s.name}${s.needs?.length ? ' <- ' + s.needs.join(', ') : ''}`));
    console.log(lines.join('\n') || '(empty: write one with `bin/learn tree --set < outline`)');
    return;
  }
  const old = new Map(); S.walkSkills(meta.skills, s => old.set(String(s.id), s));
  const oldF = new Map((meta.foundations || []).map(x => [x.id, x]));
  const roots = [], foundations = [], stack = [], seen = new Set();
  for (const raw of readStdin().split('\n')) {
    if (!raw.trim() || /^\s*#/.test(raw)) continue;
    const indent = raw.match(/^\s*/)[0].replace(/\t/g, '  ').length;
    const fm = raw.trim().match(/^@([a-z][\w-]*)\s+(.+)$/i);
    if (fm) { foundations.push({ ...(oldF.get(fm[1]) || {}), id: fm[1], name: fm[2].trim() }); continue; }
    const m = raw.trim().match(/^(\d+(?:\.\d+)*)\s+(.+?)(?:\s+<-\s*(.*))?$/);
    if (!m) die(`can't parse outline line: ${raw.trim()}`);
    const [, id, name, needs] = m;
    if (seen.has(id)) die(`duplicate id ${id}`);
    seen.add(id);
    const node = { ...(old.get(id) || {}), id, name: name.trim() };
    delete node.children;
    if (needs != null) { if (needs.trim()) node.needs = list(needs); else delete node.needs; }
    while (stack.length && stack[stack.length - 1].indent >= indent) stack.pop();
    if (stack.length) (stack[stack.length - 1].node.children ||= []).push(node); else roots.push(node);
    stack.push({ indent, node });
  }
  const dropped = [...old.keys()].filter(id => !seen.has(id));
  if (dropped.length && !f.prune) die(`the outline drops skills ${dropped.join(', ')}; add them back or pass --prune`);
  for (const n of roots) S.walkSkills([n], s => { if (s.children?.length) delete s.level; else s.level ??= 0; });
  meta.skills = roots;
  if (foundations.length || meta.foundations) meta.foundations = foundations;
  if (meta.focus && !seen.has(String(meta.focus))) meta.focus = null;
  S.saveTopicMeta(topic, meta);
  const { problems } = require('../app/check').checkTopic(topic);
  console.log(`${topic}: ${seen.size} skills, ${foundations.length} foundations${problems.length ? '\n' + problems.map(p => '  ✗ ' + p).join('\n') : ''}`);
};

commands.log = () => {
  const f = flags(argv, { topic: 'string' });
  const topic = topicOf(f);
  const text = f._.join(' ').trim();
  if (!text) die('usage: log [topic] "what happened"');
  S.appendLog(topic, text);
  console.log(`logged to ${topic}/log.md`);
};

commands.feedback = () => {
  const f = flags(argv, { topic: 'string' });
  const text = f._.join(' ').trim();
  const topic = f.topic || defaultTopic();
  const r = S.appendFeedback(text, topic || '', process.env.LEARN_SESSION ? 'tutor' : 'cli');
  console.log(`added to ${r.file}`);
};

// Tag past entries as app talk ("meta"): an appended { kind: 'tag', tag: 'meta', ids } entry, never
// an edit. They stay in the journal and the thread (dimmed, collapsed), but out of the learning
// record: wiki, session pages, stats, msgs, resume. --off appends a tag that takes it back.
commands.meta = async () => {
  const f = flags(argv, { topic: 'string', off: 'bool' });
  if (!f.topic) f.topic = (String(f._.find(x => /^[a-z0-9][a-z0-9-]*\/\d/.test(x)) || '').match(/^([a-z0-9-]+)\//) || [])[1];
  const topic = topicOf(f, true);
  const J = S.readJournal(topic), byId = new Map(J.map(e => [e.id, e]));
  const ids = [...new Set(f._.map(x => String(x).replace(/^(msg:|[a-z0-9-]+\/)/, '')))];
  if (!ids.length) die('usage: meta [topic] <id>… [--off]   (ids like 2026-11-22.33; `bin/learn recent` lists them)');
  for (const id of ids) {
    const e = byId.get(id);
    if (!e) die(`no entry ${id} in ${topic}`);
    if (!['message', 'answer', 'ask', 'action', 'start', 'meta'].includes(e.kind)) die(`${id} is a ${e.kind} entry, not a message`);
  }
  const was = S.metaIds(J);
  const todo = ids.filter(id => was.has(id) === !!f.off);
  if (!todo.length) { console.log(`nothing to do: ${ids.join(', ')} ${f.off ? 'not' : 'already'} tagged as app talk`); return; }
  const entries = [{ role: 'tutor', kind: 'tag', tag: 'meta', ids: todo, ...(f.off ? { off: true } : {}) }];
  const [saved] = (await serverUp()) ? await api('POST', '/api/append', { topic, entries }) : S.appendJournal(topic, entries);
  for (const id of todo) console.log(`${f.off ? 'untagged' : 'tagged'} ${id} [${byId.get(id).role === 'tutor' ? 'tutor' : byId.get(id).kind}] ${firstLine(byId.get(id).text, 80)}`);
  console.log(`(${saved.id}: ${f.off ? 'back in' : 'out of'} the learning record: wiki, session pages, stats, msgs, resume)`);
};

// `commit "message"` commits everything; `commit "message" -- paths…` only those files/directories
// (relative to the data home). Use paths when someone else may be writing: a background job while
// a tutor works, or the tutor while a job runs, so neither commits the other's half-written files.
commands.commit = () => {
  const i = argv.indexOf('--');
  const msg = (i >= 0 ? argv.slice(0, i) : argv).join(' ').trim();
  const paths = i >= 0 ? argv.slice(i + 1).map(S.dataPath) : [];
  if (i >= 0 && !paths.length) die('usage: commit "message" [-- path…]   (paths relative to the data home, e.g. topics/<t>/terms)');
  if (!paths.length) {
    const jobs = S.readJSON(path.join(S.STATE, 'jobs.json'), null);
    const job = jobs?.runner && T.alive(jobs.runner.pid) && jobs.current?.name;
    const tutor = process.env.LEARN_JOB && T.launcherAlive();
    if (job && process.env.LEARN_JOB !== job) console.error(`warning: the background job "${job}" is running and may be mid-edit; this commit takes its files too. Next time: bin/learn commit "…" -- <your files>`);
    else if (tutor) console.error('warning: a tutor session may be writing too; this commit takes its files as well. Next time: bin/learn commit "…" -- <your files>');
  }
  console.log(S.commitData(msg || `Update learning data ${S.localDate()}`, paths));
};

commands.pending = () => {
  const f = flags(argv, { topic: 'string' });
  const topic = topicOf(f, true);
  const p = S.pendingQuestion(S.readJournal(topic));
  if (!p) { console.log('(no pending question)'); return; }
  console.log(`${p.id}${p.skills?.length ? ' skill ' + p.skills.join(',') : ''}\n${p.text}${p.expect ? `\n\nGood answer needs: ${p.expect}` : ''}`);
};

commands.msgs = () => {
  const f = flags(argv, { topic: 'string', skill: 'string', all: 'bool' });
  const topic = topicOf(f, true);
  const tags = S.readJSON(path.join(S.topicDir(topic), 'tags.json'), {}) || {};
  const want = new Set();
  if (f.skill) { const s = S.findSkill(S.loadTopicMeta(topic), f.skill); if (!s) die(`no skill ${f.skill}`); S.walkSkills([s], x => want.add(String(x.id))); }
  const J = S.readJournal(topic), meta = S.metaIds(J);
  for (const e of J) {
    if (e.role !== 'tutor' || e.kind !== 'message') continue;
    if (meta.has(e.id) && !f.all) continue;   // app talk isn't part of any skill
    const sk = [...(e.skills || []), ...(tags[e.id] || [])].map(String);
    if (want.size && !sk.some(x => want.has(x))) continue;
    console.log(`${e.id}${sk.length ? ` [${[...new Set(sk)].join(',')}]` : ''}${e.question ? ' ?' : ''}${meta.has(e.id) ? ' (app talk)' : ''} ${firstLine(e.text)}`);
  }
};

commands.check = () => {
  const { checkTopic } = require('../app/check');
  const f = flags(argv, { quiet: 'bool' });
  const topics = f._[0] ? [f._[0]] : S.listTopics();
  let failed = false;
  for (const slug of topics) {
    if (!S.listTopics().includes(slug)) die(`unknown topic ${slug}`);
    const { problems, warnings } = checkTopic(slug);
    console.log(`${slug}: ${problems.length ? problems.length + ' problem(s)' : 'ok'}${warnings.length ? `, ${warnings.length} warning(s)` : ''}`);
    for (const p of problems) console.log('  ✗ ' + p);
    if (!f.quiet) for (const w of warnings) console.log('  · ' + w);
    failed ||= problems.length > 0;
  }
  process.exitCode = failed ? 1 : 0;
};

commands.recent = () => {
  const f = flags(argv, { topic: 'string' });
  const n = Number(f._[0]) || 12;
  const topic = f.topic || defaultTopic();
  if (!topic) die('no topic');
  const all = S.readJournal(topic), meta = S.metaIds(all);
  const J = all.slice(-n);
  for (const e of J) {
    if (e.kind === 'session') { console.log(`\n── ${e.text} · ${e.ts.slice(0, 16).replace('T', ' ')} ──`); continue; }
    if (e.kind === 'level') { console.log(`${e.id} [level] ${e.skill}: ${e.from} → ${e.to} ${e.reason || ''}`); continue; }
    if (e.kind === 'grade') { console.log(`${e.id} [grade] ${e.verdict} on ${e.target} (${e.skill || '-'}) ${e.note || ''}`); continue; }
    if (e.kind === 'tag') { console.log(`${e.id} [tag ${e.tag}${e.off ? ' off' : ''}] ${(e.ids || []).join(', ')}`); continue; }
    const tag = (e.role === 'tutor' ? `tutor${e.question ? ' ?' : ''}` : `${e.kind}${e.replyTo ? ' → ' + e.replyTo : ''}`) + (meta.has(e.id) && e.kind !== 'meta' ? ', app talk' : '');
    const text = e.role === 'tutor' && e.text.length > 700 ? e.text.slice(0, 350) + ' … ' + e.text.slice(-300) : e.text;
    console.log(`${e.id} [${tag}]${e.skills?.length ? ' skills=' + e.skills.join(',') : ''}\n${text.replace(/^/gm, '  ')}`);
  }
  const queued = S.inboxIds();
  console.log(queued.length ? `\n(${queued.length} message(s) queued for \`bin/learn wait\`)` : '');
};

commands.status = async () => {
  const up = await serverUp();
  console.log(`server: ${up ? 'up at http://localhost:' + S.PORT : 'down'} · data: ${S.ROOT}`);
  const inbox = fs.existsSync(S.INBOX) ? fs.readdirSync(S.INBOX).filter(f => f.endsWith('.json')) : [];
  console.log(`inbox: ${inbox.length} pending · feedback: ${S.openFeedback().length} open`);
  for (const slug of S.listTopics()) {
    const m = S.loadTopicMeta(slug);
    const j = S.readJournal(slug);
    const p = S.pendingQuestion(j);
    console.log(`topic ${slug}: ${m.title} — ${j.length} journal entries; focus ${m.focus || '-'}${p ? `; pending question ${p.id}` : ''}`);
  }
};

commands.show = () => {
  const f = noStrayFlags(flags(argv, { topic: 'string' }), { topic: 1 }, 'show [--topic t] <id>  ·  show <topic>/<id>');
  const id = f._[0];
  if (!id) die('usage: show [--topic t] <id>  ·  show <topic>/<id>');
  if (f.topic && !S.listTopics().includes(f.topic)) die(`unknown topic ${f.topic}`);
  // an id without a topic: the current topic first; say so when another topic has the same id
  const e = f.topic ? S.findEntry(`${f.topic}/${id.replace(/^[a-z0-9-]+\//, '')}`) : S.findEntry(id, defaultTopic());
  if (!e) die(`not found: ${id}${f.topic ? ` in ${f.topic}` : ''}`);
  if (!f.topic && !id.includes('/')) {
    const also = S.listTopics().filter(t => t !== e.topic && S.findEntry(`${t}/${id}`));
    if (also.length) console.error(`(${id} is in ${e.topic}; also in ${also.join(', ')}: \`show ${also[0]}/${id}\`)`);
  }
  const app = e.kind !== 'meta' && S.metaIds(S.readJournal(e.topic)).has(e.id) ? ' (app talk)' : '';
  console.log(`${e.id} ${e.role} ${e.kind}${app} ${e.ts}\n\n${e.text || JSON.stringify(e, null, 2)}${e.expect ? `\n\n(rubric: ${e.expect})` : ''}`);
};

commands.grep = () => {
  // case-insensitive unless --case; -i is accepted (it's the default). A pattern starting with -: grep -- -x
  const spec = { topic: 'string', all: 'bool', i: 'bool', case: 'bool' }, usage = 'grep [-i | --case] <regex> [--topic t] [--all]   (a pattern starting with -: options first, then -- <regex>)';
  const f = noStrayFlags(flags(argv, spec), spec, usage);
  if (f['--']) f._.push(...f['--']);
  if (f._.length !== 1) die(f._.length ? `one pattern, got ${f._.length}: ${f._.join(' ')} (quote it)\nusage: ${usage}` : 'usage: ' + usage);
  if (f.topic && !S.listTopics().includes(f.topic)) die(`unknown topic ${f.topic}`);
  let re;
  try { re = new RegExp(f._[0], f.case ? '' : 'i'); } catch (e) { die(`bad regex: ${e.message}`); }
  for (const slug of f.topic ? [f.topic] : S.listTopics()) {
    const J = S.readJournal(slug), meta = f.all ? new Set() : S.metaIds(J);   // app talk only with --all
    for (const e of J) {
      if (!e.text || !re.test(e.text) || meta.has(e.id)) continue;
      const i = e.text.search(re);
      const snip = e.text.slice(Math.max(0, i - 60), i + 100).replace(/\s+/g, ' ');
      console.log(`${S.listTopics().length > 1 && !f.topic ? slug + '/' : ''}${e.id} [${e.role}] …${snip}…`);
    }
  }
};

commands.new = () => {
  const [slug, ...title] = argv;
  if (!slug || !/^[a-z0-9][a-z0-9-]*$/.test(slug)) die('usage: new <slug> "Title"');
  console.log('created ' + S.createTopic(slug, title.join(' ') || slug));
};

commands.import = () => {
  const f = flags(argv, { topic: 'string' });
  if (!f.topic || !f._.length) die('usage: import <transcript.jsonl>... --topic t');
  const all = [];
  f._.forEach((file, si) => {
    let turn = null;
    const flush = () => { if (turn && turn.text.trim()) all.push(turn); turn = null; };
    all.push({ role: 'system', kind: 'session', text: `Terminal session (imported from ${path.basename(file)})`, ts: null, _file: si });
    const startIdx = all.length - 1;
    for (const line of fs.readFileSync(file, 'utf8').split('\n')) {
      if (!line.trim()) continue;
      let d; try { d = JSON.parse(line); } catch { continue; }
      if (!['user', 'assistant'].includes(d.type) || d.isSidechain || d.isMeta) continue;
      const c = d.message && d.message.content;
      let txt = typeof c === 'string' ? c : (c || []).filter(b => b.type === 'text').map(b => b.text).join('\n\n');
      txt = (txt || '').trim();
      if (!txt || /^<(command|local-command|system-reminder|task-notification)/.test(txt) || /^Caveat:/.test(txt)) continue;
      const role = d.type === 'user' ? 'user' : 'tutor';
      if (turn && turn.role === role) { turn.text += '\n\n' + txt; continue; }
      flush();
      turn = { role, kind: 'message', text: txt, ts: d.timestamp, imported: true };
    }
    flush();
    all[startIdx].ts = all[startIdx + 1] ? all[startIdx + 1].ts : new Date().toISOString();
  });
  all.sort((a, b) => a.ts < b.ts ? -1 : a.ts > b.ts ? 1 : 0);
  const byDate = new Map();
  for (const e of all) { delete e._file; const dt = S.localDate(new Date(e.ts)); (byDate.get(dt) || byDate.set(dt, []).get(dt)).push(e); }
  let n = 0;
  for (const [dt, es] of byDate) { n += S.appendJournal(f.topic, es, dt).length; }
  console.log(`imported ${n} entries into ${f.topic} (${[...byDate.keys()].join(', ')})`);
};

if (argv[0] && !argv[0].startsWith('-')) {
  if (commands[argv[0]]) cmd = argv.shift();
  else if (!S.listTopics().includes(argv[0])) die(`unknown command or topic "${argv[0]}"; try bin/learn help`);
}
// sync and async commands alike: an error is a one-line message, not a stack trace
Promise.resolve().then(() => commands[cmd]()).catch(e => die(e.message));
