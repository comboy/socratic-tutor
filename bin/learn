  console.log(`bin/learn [topic] [-c] [--no-open] [--host ip] [-- agent args]   web UI + idle tutor + browser; the only
                                         command the learner needs (already running? it just opens the browser).
                                         -c continues the last agent session instead of a fresh one
                                         --host 0.0.0.0 (all addresses) or one IP: reachable from other machines, with an
